10. Three-Operand Instructions
[문제] 메모리 DWORD 세 개를 받아 add3, sub3, mul3, div3 연산을 구현한다. EAX 이외 변경하는 레지스터는 보존한다.

[정답]
INCLUDE Irvine32.inc

add3 MACRO dest:REQ, src1:REQ, src2:REQ
    mov eax,src1
    add eax,src2
    mov dest,eax
ENDM

sub3 MACRO dest:REQ, src1:REQ, src2:REQ
    mov eax,src1
    sub eax,src2
    mov dest,eax
ENDM

mul3 MACRO dest:REQ, src1:REQ, src2:REQ
    mov eax,src1
    imul eax,src2
    mov dest,eax
ENDM

div3 MACRO dest:REQ, src1:REQ, src2:REQ
    push edx
    mov eax,src1
    cdq
    idiv src2
    mov dest,eax
    pop edx
ENDM

.data
w SDWORD 20
y SDWORD 10
z SDWORD 5
temp SDWORD ?
r1 SDWORD ?
r2 SDWORD ?
r3 SDWORD ?
r4 SDWORD ?

.code
main PROC
    ; r1 = (w + y) * z
    add3 temp,w,y
    mul3 r1,temp,z

    ; r2 = (w - y) * z
    sub3 temp,w,y
    mul3 r2,temp,z

    ; r3 = w * z + y
    mul3 temp,w,z
    add3 r3,temp,y

    ; r4 = (w + y) / z
    add3 temp,w,y
    div3 r4,temp,z

    mov eax,r1
    call WriteInt
    call Crlf
    mov eax,r2
    call WriteInt
    call Crlf
    mov eax,r3
    call WriteInt
    call Crlf
    mov eax,r4
    call WriteInt
    call Crlf
    exit
main ENDP
END main

[풀이]
각 매크로의 인자 순서는 목적지, 원본1, 원본2다.
DIV는 signed 나눗셈이므로 CDQ로 EDX:EAX를 부호 확장한다.
DIV가 사용하는 EDX는 PUSH/POP으로 보존한다. 0으로 나누면 예외가 발생한다.

[결과] 150 / 50 / 110 / 6 (줄마다 출력)

