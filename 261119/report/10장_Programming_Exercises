5. mReadInt Macro
[문제] 16비트 또는 32비트 부호 있는 정수를 입력받아 대상 변수 크기에 맞게 저장하는 매크로를 작성한다.

[정답]
INCLUDE Irvine32.inc

mReadInt MACRO outVar:REQ
    call ReadInt
    IF TYPE outVar EQ 2
        mov outVar,ax
    ELSEIF TYPE outVar EQ 4
        mov outVar,eax
    ELSE
        ECHO mReadInt requires WORD or DWORD storage
        EXITM
    ENDIF
ENDM

.data
smallValue SWORD ?
largeValue SDWORD ?
msg1 BYTE "Enter 16-bit signed value: ",0
msg2 BYTE "Enter 32-bit signed value: ",0

.code
main PROC
    mov edx,OFFSET msg1
    call WriteString
    mReadInt smallValue
    mov edx,OFFSET msg2
    call WriteString
    mReadInt largeValue

    movsx eax,smallValue
    call WriteInt
    call Crlf
    mov eax,largeValue
    call WriteInt
    call Crlf
    exit
main ENDP
END main

[풀이]
TYPE outVar은 어셈블 시 판단할 수 있으므로 IF 지시어로 AX 또는 EAX를 선택한다.
16비트 입력은 -32768~32767 범위를 사용해야 잘림이 없다.

