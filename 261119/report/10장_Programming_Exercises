9. Shifting Multiple Doublewords
[문제] 리틀 엔디언 DWORD 배열을 SHRD/SHLD로 왼쪽 또는 오른쪽에 임의 비트 수만큼 이동하는 매크로를 작성한다.

[정답]
INCLUDE Irvine32.inc

mShiftDoublewords MACRO arr:REQ, direction:REQ, bitCount:REQ
    LOCAL BitAgain, RLoop, RLast, LLoop, LLast, Done
    pushad
    mov ebx,bitCount
    cmp ebx,0
    jle Done
BitAgain:
    IFIDNI <direction>,<R>
        mov esi,OFFSET arr
        mov ecx,LENGTHOF arr
        dec ecx
        jz RLast
RLoop:
        mov eax,[esi+4]
        shrd DWORD PTR [esi],eax,1
        add esi,4
        loop RLoop
RLast:
        shr DWORD PTR [esi],1
    ELSE
        IFIDNI <direction>,<L>
            mov esi,OFFSET arr
            add esi,(LENGTHOF arr - 1)*4
            mov ecx,LENGTHOF arr
            dec ecx
            jz LLast
LLoop:
            mov eax,[esi-4]
            shld DWORD PTR [esi],eax,1
            sub esi,4
            loop LLoop
LLast:
            shl DWORD PTR [esi],1
        ELSE
            ECHO Direction must be R or L
            EXITM
        ENDIF
    ENDIF
    dec ebx
    jnz BitAgain
Done:
    popad
ENDM

.data
rightArray DWORD 11223344h,55667788h,99AABBCCh
leftArray  DWORD 11223344h,55667788h,99AABBCCh

.code
main PROC
    mShiftDoublewords rightArray,R,5
    mShiftDoublewords leftArray,L,5

    mov esi,OFFSET rightArray
    mov ecx,LENGTHOF rightArray
    mov ebx,TYPE rightArray
    call DumpMem
    call Crlf

    mov esi,OFFSET leftArray
    mov ecx,LENGTHOF leftArray
    mov ebx,TYPE leftArray
    call DumpMem
    exit
main ENDP
END main

[풀이]
배열의 0번 DWORD가 최하위 32비트인 리틀 엔디언 구조다.
오른쪽 이동은 낮은 주소부터 SHRD를 사용하고 마지막 상위 DWORD는 SHR한다.
왼쪽 이동은 높은 주소부터 SHLD를 사용하고 마지막 하위 DWORD는 SHL한다.
1비트 이동을 bitCount회 반복하므로 bitCount가 32보다 커도 처리할 수 있다.

