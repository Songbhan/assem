8. Drunkard’s Walk with Probabilities
[문제] 직전 이동 방향 유지 50%, 반대 10%, 왼쪽 20%, 오른쪽 20%가 되도록 걸음 방향을 수정한다.

[정답]
INCLUDE Irvine32.inc

WalkMax = 50
StartX = 25
StartY = 25

DrunkardWalk STRUCT
    path COORD WalkMax DUP(<0,0>)
    pathsUsed WORD 0
DrunkardWalk ENDS

.data
aWalk DrunkardWalk <>
xPos SDWORD StartX
yPos SDWORD StartY
curDir DWORD 0              ; 0=N, 1=E, 2=S, 3=W

.code
main PROC
    call Randomize
    mov edi,OFFSET aWalk.path
    mov ecx,WalkMax
NextWalk:
    push ecx
    mov eax,10
    call RandomRange         ; 0..9
    pop ecx
    cmp eax,5
    jb DirectionReady       ; 0..4 : 유지(50%)
    cmp eax,6
    je ReverseDir           ; 5    : 반대(10%)
    cmp eax,8
    jb TurnLeft             ; 6..7 : 왼쪽(20%)
    inc curDir              ; 8..9 : 오른쪽(20%)
    jmp Normalize
ReverseDir:
    add curDir,2
    jmp Normalize
TurnLeft:
    add curDir,3
Normalize:
    and curDir,3
DirectionReady:
    mov eax,curDir
    cmp eax,0
    je North
    cmp eax,1
    je East
    cmp eax,2
    je South
    dec xPos
    jmp RecordPosition
North:
    dec yPos
    jmp RecordPosition
East:
    inc xPos
    jmp RecordPosition
South:
    inc yPos
RecordPosition:
    mov eax,xPos
    mov (COORD PTR [edi]).X,ax
    mov eax,yPos
    mov (COORD PTR [edi]).Y,ax
    add edi,TYPE COORD

    pushad
    mov eax,xPos
    call WriteInt
    mov al,','
    call WriteChar
    mov eax,yPos
    call WriteInt
    call Crlf
    popad
    loop NextWalk

    mov aWalk.pathsUsed,WalkMax
    exit
main ENDP
END main

[풀이]
방향을 시계방향으로 0=N,1=E,2=S,3=W로 지정했다.
기존 방향에 2를 더하면 반대, 3을 더하면 왼쪽, 1을 더하면 오른쪽이다.
AND 3으로 결과를 0~3으로 유지한다.

