7. The Professor's Lost Phone
[문제] 10.1.6의 DrunkardWalk에서 임의의 한 시점에 휴대폰을 떨어뜨리도록 수정한다. 위치도 기록한다.

[정답]
INCLUDE Irvine32.inc

WalkMax = 50
StartX = 25
StartY = 25

DrunkardWalk STRUCT
    path COORD WalkMax DUP(<0,0>)
    pathsUsed WORD 0
    phoneStep WORD 0
    phoneX SWORD 0
    phoneY SWORD 0
DrunkardWalk ENDS

TakeWalk PROTO pWalk:PTR DrunkardWalk

.data
aWalk DrunkardWalk <>
stepMsg BYTE "Lost at step: ",0
posMsg  BYTE "Position(X,Y): ",0
comma   BYTE ", ",0

.code
main PROC
    call Randomize
    INVOKE TakeWalk,ADDR aWalk

    mov edx,OFFSET stepMsg
    call WriteString
    movzx eax,aWalk.phoneStep
    inc eax
    call WriteDec
    call Crlf

    mov edx,OFFSET posMsg
    call WriteString
    movsx eax,aWalk.phoneX
    call WriteInt
    mov edx,OFFSET comma
    call WriteString
    movsx eax,aWalk.phoneY
    call WriteInt
    call Crlf
    exit
main ENDP

TakeWalk PROC USES ebx ecx esi edi, pWalk:PTR DrunkardWalk
    LOCAL xPos:SWORD, yPos:SWORD, phoneAt:DWORD, stepNo:DWORD

    mov esi,pWalk
    mov edi,esi
    add edi,OFFSET DrunkardWalk.path
    mov xPos,StartX
    mov yPos,StartY
    mov stepNo,0

    mov eax,WalkMax
    call RandomRange
    mov phoneAt,eax

    mov ecx,WalkMax
L1:
    mov ax,xPos
    mov (COORD PTR [edi]).X,ax
    mov ax,yPos
    mov (COORD PTR [edi]).Y,ax

    mov eax,stepNo
    cmp eax,phoneAt
    jne MoveNext
    mov (DrunkardWalk PTR [esi]).phoneStep,ax
    mov ax,xPos
    mov (DrunkardWalk PTR [esi]).phoneX,ax
    mov ax,yPos
    mov (DrunkardWalk PTR [esi]).phoneY,ax

MoveNext:
    push ecx
    mov eax,4
    call RandomRange
    pop ecx
    cmp eax,0
    je North
    cmp eax,1
    je South
    cmp eax,2
    je West
    inc xPos
    jmp NextStep
North:
    dec yPos
    jmp NextStep
South:
    inc yPos
    jmp NextStep
West:
    dec xPos
NextStep:
    add edi,TYPE COORD
    inc stepNo
    loop L1

    mov (DrunkardWalk PTR [esi]).pathsUsed,WalkMax
    ret
TakeWalk ENDP
END main

[풀이]
0~49 중 임의의 단계 하나를 고르고, 그 단계의 좌표를 구조체에 기록한다.
Randomize로 실행마다 난수 시퀀스를 초기화한다. 떨어뜨린 단계는 1부터 출력한다.

